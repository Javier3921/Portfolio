# Variables de entorno para api/chat.js (el proxy hacia Gemini).
# NO pongas tus valores reales acá — este archivo sí se sube al repo, solo
# sirve de plantilla. Los valores reales van en Vercel: Settings ->
# Environment Variables del proyecto.

# Obligatoria. Se genera en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional. Por defecto usa gemini-3.6-flash (el mismo valor por defecto que api/chat.js).
# GEMINI_MODEL=gemini-3.6-flash

# Opcional. Dominio permitido para llamar al endpoint desde un navegador.
# Por defecto es el dominio de producción en Vercel; solo hace falta
# cambiarlo si el sitio pasa a otro dominio (ej. uno propio).
# SITE_ORIGIN=https://portfolio-mu-wine-90.vercel.app
