# Variables de entorno para api/chat.js (el proxy hacia Gemini).
# NO pongas tus valores reales acá — este archivo sí se sube al repo, solo
# sirve de plantilla. Los valores reales van en Vercel: Settings ->
# Environment Variables del proyecto.

# Obligatoria. Se genera en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional. Por defecto usa gemini-2.5-flash (nivel gratuito confirmado).
# GEMINI_MODEL=gemini-2.5-flash

# Opcional. Restringe el CORS del endpoint a tu dominio final una vez que
# lo conozcas (ej. https://tu-sitio.vercel.app). Mientras no se configure,
# el endpoint acepta llamadas desde cualquier origen.
# SITE_ORIGIN=https://tu-sitio.vercel.app
